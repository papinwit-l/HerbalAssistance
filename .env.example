ANTHROPIC_API_KEY=
MONGODB_URI=
NEXT_PUBLIC_LIFF_ID=
LINE_CHANNEL_ID=
DATA_ENCRYPTION_KEY=
HMAC_SECRET=
NEXT_PUBLIC_APP_URL=
# Herb data: the team's PHP export (reads MySQL). Server-side only — never NEXT_PUBLIC_.
# The chat page reads it at runtime; empty URL = use the bundled src/data/herbs.json.
# npm run sync-data uses the same values to refresh that bundled fallback file.
HERBS_EXPORT_URL=
HERBS_EXPORT_TOKEN=
HERBS_REVALIDATE_SECONDS=300

# Sites allowed to embed the chat in an <iframe> (space-separated origins), e.g. the PHP app.
# Empty = nobody else. Needs a rebuild / restart to take effect.
EMBED_ALLOWED_ORIGINS=

# Contact line on /privacy (server-only, read at build). e.g. "อีเมล team@example.com"
PRIVACY_CONTACT=
